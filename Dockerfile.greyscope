FROM ghcr.io/astral-sh/uv:0.9.18 AS uv

FROM python:3.12.12-slim-bookworm

ENV HF_HOME=/cache/huggingface \
    PATH=/app/.venv/bin:$PATH \
    PYTHONPATH=/app/src \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy

COPY --from=uv /uv /uvx /bin/

WORKDIR /app

COPY greyscope/pyproject.toml greyscope/uv.lock ./
RUN uv sync --frozen --no-dev --no-install-project

COPY src ./src
RUN useradd --uid 1000 --create-home app \
    && mkdir -p /cache/huggingface \
    && chown -R app:app /cache

USER app

EXPOSE 8001

HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8001/api/status', timeout=3)"

CMD ["uvicorn", "ai_detector.greyscope_web:app", "--host", "0.0.0.0", "--port", "8001"]
